APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/customer_support
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/customer_support_test

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=customer_support
POSTGRES_PORT=5432

GROQ_API_KEY=
GROQ_MODEL=

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
INTENT_MODEL_PATH=
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest

TOP_K=5
SIMILARITY_THRESHOLD=0.0
MAX_COMPLAINT_LENGTH=5000
CORS_ORIGINS=http://localhost:3000

# Port the backend container binds to (docs/deployment/DEPLOYMENT_SPEC.md).
# Only read by backend/docker-entrypoint.sh; not an app Settings field.
PORT=8000

# Read by docker-compose.prod.yml as a frontend Docker build ARG (single-VPS
# deployment, deploy/nginx/ai-customer-support.conf). Left relative so the
# browser calls the same origin/domain as the page and Nginx proxies it to
# the backend -- do not set this to an absolute http://localhost:8000 URL in
# production. Not read by `npm run dev` (see frontend/.env.example for that).
NEXT_PUBLIC_API_URL=/api/v1
